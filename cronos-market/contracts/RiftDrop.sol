pragma solidity ^0.8.24;
import '@openzeppelin/contracts/token/ERC721/ERC721.sol';
import '@openzeppelin/contracts/token/common/ERC2981.sol';
import '@openzeppelin/contracts/access/Ownable.sol';
import '@openzeppelin/contracts/utils/Pausable.sol';
import '@openzeppelin/contracts/utils/ReentrancyGuard.sol';
import '@openzeppelin/contracts/utils/Base64.sol';
import '@openzeppelin/contracts/utils/Strings.sol';
import '@openzeppelin/contracts/utils/cryptography/MerkleProof.sol';
/// @notice Unaudited zero-platform-fee launch primitive. Mode 0 generated SVG, 1 shared creator SVG, 2 IPFS directory.
contract RiftDrop is ERC721, ERC2981, Ownable, Pausable, ReentrancyGuard {
 using Strings for uint256;
 struct Config {string name;string symbol;uint256 supply;uint256 walletLimit;uint256 txLimit;uint256 price;uint64 start;uint64 end;uint64 allowlistEnd;bytes32 root;uint8 mode;string content;address creator;uint96 royaltyBps;string description;string externalUrl;string collectionImage;string collectionBanner;}
 uint256 public immutable maxSupply;uint256 public immutable walletLimit;uint256 public immutable txLimit;uint256 public immutable mintPrice;uint64 public immutable start;uint64 public immutable end;uint64 public immutable allowlistEnd;bytes32 public immutable merkleRoot;uint8 public immutable storageMode;
 uint256 public totalMinted;mapping(address=>uint256)public mintedBy;string private content;string public collectionDescription;string public externalUrl;string public collectionImage;string public collectionBanner;address public immutable originalCreator;uint96 public immutable creatorRoyaltyBps;
 event Minted(address indexed collector,uint256 quantity,uint256 firstTokenId);
 constructor(Config memory c) ERC721(c.name,c.symbol) Ownable(c.creator){require(bytes(c.name).length>0&&bytes(c.name).length<=64&&bytes(c.symbol).length>0&&bytes(c.symbol).length<=12,'Invalid name');for(uint256 i;i<bytes(c.name).length;i++)require(uint8(bytes(c.name)[i])>=32&&uint8(bytes(c.name)[i])<=126,'ASCII name required');require(bytes(c.description).length<=1000&&bytes(c.externalUrl).length<=256,'Metadata too long');require(c.supply>0&&c.supply<=100000&&c.walletLimit>0&&c.walletLimit<=c.supply&&c.txLimit>0&&c.txLimit<=c.walletLimit,'Invalid limits');require(c.end==0||c.end>c.start,'Invalid window');require(c.royaltyBps<=1000,'Royalty too high');require(c.mode<=2,'Invalid mode');if(c.root!=bytes32(0))require(c.allowlistEnd>c.start&&(c.end==0||c.allowlistEnd<=c.end),'Invalid allowlist window');if(c.mode==1)require(bytes(c.content).length>0&&bytes(c.content).length<=12000,'Invalid SVG size');if(c.mode==2){bytes memory b=bytes(c.content);require(b.length>8&&b.length<=256&&b[0]=='i'&&b[1]=='p'&&b[2]=='f'&&b[3]=='s'&&b[4]==':'&&b[5]=='/'&&b[6]=='/'&&b[b.length-1]=='/','Invalid IPFS directory');}maxSupply=c.supply;walletLimit=c.walletLimit;txLimit=c.txLimit;mintPrice=c.price;start=c.start;end=c.end;allowlistEnd=c.allowlistEnd;merkleRoot=c.root;storageMode=c.mode;content=c.content;collectionDescription=c.description;externalUrl=c.externalUrl;require(bytes(c.collectionImage).length<=512&&bytes(c.collectionBanner).length<=512,'Artwork URI too long');collectionImage=c.collectionImage;collectionBanner=c.collectionBanner;originalCreator=c.creator;creatorRoyaltyBps=c.royaltyBps;_setDefaultRoyalty(c.creator,c.royaltyBps);}
 function mint(uint256 quantity,bytes32[] calldata proof)external payable nonReentrant whenNotPaused {require(block.timestamp>=start&&(end==0||block.timestamp<end),'Mint not live');require(quantity>0&&quantity<=txLimit,'Invalid quantity');require(totalMinted+quantity<=maxSupply,'Sold out');require(mintedBy[msg.sender]+quantity<=walletLimit,'Wallet limit');require(msg.value==mintPrice*quantity,'Wrong payment');if(merkleRoot!=bytes32(0)&&block.timestamp<allowlistEnd){bytes32 leaf=keccak256(bytes.concat(keccak256(abi.encode(msg.sender))));require(MerkleProof.verifyCalldata(proof,merkleRoot,leaf),'Not allowlisted');}uint256 first=totalMinted+1;mintedBy[msg.sender]+=quantity;totalMinted+=quantity;for(uint256 i=0;i<quantity;i++)_safeMint(msg.sender,first+i);emit Minted(msg.sender,quantity,first);}
 function totalSupply()external view returns(uint256){return totalMinted;}
 function _image(uint256 id)internal view returns(string memory){return string.concat('data:image/svg+xml;base64,',Base64.encode(bytes(storageMode==1?content:_art(id))));}
 function tokenURI(uint256 id)public view override returns(string memory){_requireOwned(id);if(storageMode==2)return string.concat(content,id.toString(),'.json');
 string memory head=string.concat('{"name":"',_escape(name()),' #',id.toString(),'","description":"',_escape(collectionDescription),'","image":"',_image(id),'","external_url":"',_escape(externalUrl),'",');
 string memory traits=string.concat('"attributes":[{"trait_type":"Storage","value":"Fully on-chain"},{"trait_type":"Renderer","value":"',storageMode==0?'Generative SVG':'Creator SVG','"},{"display_type":"number","trait_type":"Token ID","value":',id.toString(),'}');
 if(storageMode==0)traits=string.concat(traits,',{"display_type":"number","trait_type":"Hue","value":',(uint256(keccak256(abi.encode(id)))%360).toString(),'}');
 return string.concat('data:application/json;base64,',Base64.encode(bytes(string.concat(head,traits,']}'))));}
 /// @notice Collection-level metadata. IPFS launches must pin contract.json in the metadata directory.
 function contractURI()external view returns(string memory){if(storageMode==2)return string.concat(content,'contract.json');string memory head=string.concat('{"name":"',_escape(name()),'","description":"',_escape(collectionDescription),'","image":"',bytes(collectionImage).length>0?_escape(collectionImage):_image(1),'","banner_image":"',_escape(collectionBanner),'","external_link":"',_escape(externalUrl),'",');return string.concat('data:application/json;base64,',Base64.encode(bytes(string.concat(head,'"seller_fee_basis_points":',uint256(creatorRoyaltyBps).toString(),',"fee_recipient":"',Strings.toHexString(uint160(originalCreator),20),'"}'))));}
 function _escape(string memory value)internal pure returns(string memory){bytes memory input=bytes(value);bytes memory out=new bytes(input.length*6);bytes memory hexChars='0123456789abcdef';uint256 n;for(uint256 i;i<input.length;i++){uint8 c=uint8(input[i]);if(c==34||c==92){out[n++]='\\';out[n++]=input[i];}else if(c<32){out[n++]='\\';out[n++]='u';out[n++]='0';out[n++]='0';out[n++]=hexChars[c>>4];out[n++]=hexChars[c&15];}else out[n++]=input[i];}assembly{mstore(out,n)}return string(out);}
 function _art(uint256 id)internal pure returns(string memory){uint256 h=uint256(keccak256(abi.encode(id)));string memory hue=(h%360).toString();return string.concat('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320"><rect width="320" height="320" fill="#101522"/><g fill="hsl(',hue,',70%,60%)"><path d="M65 95V45l55 30h80l55-30v50l20 40v120H45V135z"/><rect x="25" y="255" width="270" height="35" opacity=".35"/></g><g fill="#111827"><rect x="85" y="135" width="45" height="35"/><rect x="190" y="135" width="45" height="35"/><path d="M145 195h30l-15 20z"/></g><g fill="#e8ffd8"><rect x="100" y="140" width="15" height="15"/><rect x="205" y="140" width="15" height="15"/></g><text x="160" y="280" text-anchor="middle" font-family="monospace" font-size="14" fill="white">RIFT #',id.toString(),'</text></svg>');}
 function renounceOwnership()public pure override{revert('Use ownership transfer');}
 function pause()external onlyOwner{_pause();}function unpause()external onlyOwner{_unpause();}
 function withdraw()external onlyOwner nonReentrant{(bool ok,)=payable(owner()).call{value:address(this).balance}('');require(ok,'Withdrawal failed');}
 function supportsInterface(bytes4 i)public view override(ERC721,ERC2981)returns(bool){return super.supportsInterface(i);}
}
