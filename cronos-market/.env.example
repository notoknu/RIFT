# Optional only for RIFT native trading after real contract deployment.
VITE_NFT_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
# Collection directory uses public Minted data; no API key needed.

# Public WalletConnect project ID, not a private key. Allowlist your HTTPS domain
# in the WalletConnect/Reown dashboard, then rebuild.
# Omit to use the official public ID; explicitly empty disables WalletConnect.
# VITE_WALLETCONNECT_PROJECT_ID=
# Production backend
PORT=4173
# TRUSTED_PROXY=loopback
# Read-only deployment preparation
MARKET_ADMIN_ADDRESS=
DEPLOYER_ADDRESS=
# Never put deployment private keys in VITE_* variables or commit them.

# Shared production abuse protection (required unless explicitly single-process).
REDIS_URL=
# ALLOW_SINGLE_PROCESS_LIMITS=1
# Optional durable wallet transfer backfill; start at zero for full event history.
INDEXER_ENABLED=0
INDEX_DB=data/wallet-index.sqlite
INDEX_START_BLOCK=0
INDEX_BLOCK_SPAN=1000
# Docker TLS endpoint: configure DNS and open ports 80/443 before starting.
SITE_DOMAIN=

# Explicit RIFT-native marketplace index. No genesis scan or write wallet required.
# Set the actual deployment receipt block, not an invented value.
MARKETPLACE_ADDRESS=
MARKET_START_BLOCK=
MARKET_INDEX_DB=data/market-index.sqlite
MARKET_BLOCK_SPAN=1000
# Optional reviewed factory address. Blank preserves direct per-drop deployment.
# Factory source/tests exist; mainnet deployment/verification is not performed.
VITE_DROP_FACTORY_ADDRESS=

# Creator accounts: exact HTTPS frontend origin. Disabled until configured.
# For local development only, loopback http://localhost:PORT is accepted.
PUBLIC_ORIGIN=
CREATOR_DB=data/creator.sqlite
# Same reviewed factory as VITE_DROP_FACTORY_ADDRESS, plus actual runtime hash.
DROP_FACTORY_ADDRESS=
DROP_FACTORY_RUNTIME_HASH=
# Optional platform-owned public IPFS upload account. SECRET: server-side only.
# Defaults disable sponsorship. Never expose this in VITE_* or commit a JWT.
PINATA_JWT=
PIN_SPONSORED_BYTES=0
PIN_SPONSORED_FILES=0
# Edge provisioning helper only — public resource ID from your actual D1 account.
D1_DATABASE_ID=

# Separate v2 native-funded/ERC1155 exchange. Keep disabled until review/release.
EXCHANGE_ADDRESS=
EXCHANGE_START_BLOCK=
EXCHANGE_RUNTIME_HASH=
EXCHANGE_INDEX_DB=data/exchange.sqlite
EXCHANGE_TRADING_ENABLED=0

# Deployment-scoped collection ingestion. Never starts anonymous genesis scans.
# JSON array entries: address, startBlock (actual deployment), standard. Optional path.
COLLECTION_INDEXES_JSON=[]
COLLECTION_INDEX_DIR=data/collections
# Auto-admit only already receipt-verified RIFT factory registry entries.
INDEX_REGISTERED_COLLECTIONS=0

# Optional trusted operator monitoring. No notifications unless explicitly set.
MONITOR_BASE_URL=
MONITOR_WEBHOOK_URL=
MONITOR_STATE_FILE=data/monitor-state.json
MONITOR_MAX_AGE_MS=600000
MONITOR_INTERVAL_MS=60000
# Explicit source array: each entry has unique kind and an actual SQLite path.
BACKUP_SOURCES_JSON=[]
BACKUP_LOCAL_DIR=backups/replication
# Operator-controlled independent encrypted backup mount; disabled until set.
BACKUP_REPLICA_DIR=
# Private 32-byte random key file OUTSIDE the repository (0600). Never commit it.
BACKUP_KEY_FILE=
# Explicit additional metadata/media HTTPS hosts approved for Worker egress.
EDGE_METADATA_HOSTS=

# Optional Worker scheduled Minted catalog (bounded, source-scoped; measure quotas).
EDGE_CATALOG_ENABLED=0

# Backend RPC for portfolio, token and collection-profile contract reads.
CRONOS_RPC_URL=https://evm.cronos.org

# Optional remote authoritative account database (server-side only).
# Default remains sqlite; never put either value into VITE_* variables.
CREATOR_DB_DRIVER=sqlite
CREATOR_LIBSQL_URL=
CREATOR_LIBSQL_AUTH_TOKEN=
