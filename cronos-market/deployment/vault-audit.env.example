# EXAMPLE ONLY: install a private reviewed environment file at /etc/rift/vault-audit.env.
# Replace ID/head from an independently saved trusted receipt, not automatic vault discovery.
RIFT_VAULT_ID=REPLACE_WITH_PINNED_VAULT_UUID
RIFT_VAULT_HEAD=REPLACE_WITH_PINNED_64_HEX_HEAD
RIFT_VAULT_CATALOG_KEY_FILE=/etc/rift/keys/catalog.key
RIFT_VAULT_CATALOG_KEY_ID=REPLACE_WITH_CATALOG_KEY_ID
RIFT_VAULT_AUDIT_KEYRING_FILE=/etc/rift/keys/artifact-key-files.json
