# TEMPLATE ONLY. Review host paths, Node >=22.13, ownership and TLS proxy before installation.
[Unit]
Description=RIFT authenticated encrypted backup receiver
After=network-online.target
Wants=network-online.target
[Service]
User=rift
Group=rift
WorkingDirectory=/opt/rift
ExecStart=/usr/bin/node /opt/rift/scripts/independence-ops.js /etc/rift/backup-receiver.json
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rift-recovery
[Install]
WantedBy=multi-user.target
